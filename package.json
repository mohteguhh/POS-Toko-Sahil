{
  "name": "toko-sahil-pos",
  "version": "1.0.0",
  "description": "Aplikasi Kasir POS & Inventaris Toko Sahil Desktop",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64",
    "build:x64": "electron-builder --win --x64",
    "build:ia32": "electron-builder --win --ia32",
    "build:all": "electron-builder --win --x64 --ia32"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mohteguhh/POS-Toko-Sahil.git"
  },
  "author": "Toko Sahil",
  "license": "ISC",
  "dependencies": {
    "adm-zip": "^0.6.1"
  },
  "devDependencies": {
    "electron": "^22.3.27",
    "electron-builder": "^26.15.3",
    "pptxgenjs": "^4.0.1"
  },
  "build": {
    "appId": "com.tokosahil.pos",
    "productName": "Kasir Toko Sahil",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ],
      "icon": "app-icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Kasir Toko Sahil",
      "artifactName": "${productName} Setup ${version} (${arch}).${ext}"
    },
    "files": [
      "**/*",
      "!backup database/*",
      "!*.bat"
    ]
  }
}
